# Free by default. Chat uses Ollama if running, otherwise local FAQ.
# No paid API is used unless you explicitly opt in below.
CHAT_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Google Apps Script web app that appends leads to Sheets (/exec, access: Anyone).
# See google-apps-script/Code.gs for the deploy steps.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyLBGzE5Fk5xcmn3D6mDsIeY0GvjPiAJXCv_6Y58Dxv-9mVNnND0Jh1jSyjXqqovNSA/exec

# Lead alert inboxes (comma-separated). Used by Node/FormSubmit fallback.
LEAD_NOTIFY_EMAIL=contact@fitnessgurukul.co.in,fitnessgurukul01@gmail.com
# FORMSUBMIT_DISABLE=1

# Optional: real free AI — install https://ollama.com then run:
#   ollama pull llama3.2

# Optional paid OpenAI (disabled unless you set one of these):
# CHAT_PROVIDER=openai
# CHAT_ALLOW_OPENAI=true
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-5.6
