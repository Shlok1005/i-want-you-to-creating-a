{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"No npm install required\"",
  "buildCommand": "bash scripts/prepare-static-dist.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/submit", "destination": "/api/submit" }
  ]
}
